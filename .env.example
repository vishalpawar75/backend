# PostgreSQL connection (choose either DATABASE_URL or individual PG* vars)
# DATABASE_URL=postgres://user:password@localhost:5432/vakratund
PGHOST=localhost
PGPORT=5432
PGUSER=vakratund
PGPASSWORD=vakratund
PGDATABASE=vakratund

# Frontend URL for CORS (update for production)
CORS_ORIGIN=http://localhost:4200

# Optional cron for automated ingestion (not enabled by default)
# INGEST_CRON=0 4 1 * *

# Optional: allow analytics to fall back to demo dataset if DB empty
ALLOW_DEMO_FALLBACK=true

# Gemini API key for crop diagnosis (image analysis)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
